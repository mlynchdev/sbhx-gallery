# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string

# --- Local development (no Cloudflare or Authentik needed) ---
FLASK_DEBUG=1
DB_BACKEND=sqlite
STORAGE_BACKEND=local
DEV_LOGIN=1

# --- Production ---
# SESSION_COOKIE_SECURE=1
# DEV_LOGIN=0

# Cloudflare account (used by both D1 and R2)
# CF_ACCOUNT_ID=

# D1 via the HTTP API. Token needs "D1: Edit" permission.
# DB_BACKEND=d1
# CF_API_TOKEN=
# D1_DATABASE_ID=

# R2 via its S3-compatible API. Create an R2 API token with Object Read & Write on the bucket.
# STORAGE_BACKEND=r2
# R2_BUCKET=sbhx-photos
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Optional public URL for the bucket (custom domain or r2.dev). Empty = presigned GETs.
# R2_PUBLIC_BASE_URL=https://photos.sbhackerspace.com

# Authentik OAuth2/OpenID provider
# Redirect URI to register in Authentik: https://<your-host>/auth/callback
# OIDC_DISCOVERY_URL=https://auth.example.com/application/o/photo-share/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# MAX_UPLOAD_BYTES=26214400
